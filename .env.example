# Copié en .env par install.sh. Jamais de secrets dans git.

DEMO=1

# PostgreSQL
DATABASE_URL=postgresql://scraping_grok:scraping_grok@127.0.0.1:5432/scraping_grok

# Logs : DEBUG par défaut (scraping-grok scrape --quiet pour INFO)
# LOG_DIR=logs
# LOG_QUIET=0

CONCURRENCY=8
NLP_CONCURRENCY=4
REQUEST_TIMEOUT=20
CONFIDENCE_THRESHOLD=0.7
LLM_MAX_CHARS=1800
MAX_ARTICLES=50
USER_AGENT=Scraping-Grok-Support/1.0 (pedagogical)

# --- Connecteur Grok (API xAI) ---
XAI_API_KEY=
GROK_MODEL=grok-4.5
GROK_BASE_URL=https://api.x.ai/v1

# Copié en .env par install.sh. Jamais de secrets dans git.

DEMO=1

# PostgreSQL
DATABASE_URL=postgresql://sscraping:sscraping@127.0.0.1:5432/sscraping

# Logs : DEBUG par défaut (sscraping scrape --quiet pour INFO)
# LOG_DIR=logs
# LOG_QUIET=0

CONCURRENCY=8
NLP_CONCURRENCY=4
REQUEST_TIMEOUT=20
CONFIDENCE_THRESHOLD=0.7
MAX_ARTICLES=50
USER_AGENT=ss-craping-bot/1.0 (pedagogical)

# --- Connecteur Grok (API xAI) ---
XAI_API_KEY=
GROK_MODEL=grok-4.5
GROK_BASE_URL=https://api.x.ai/v1

# --- Connecteur V100 32 Go (serveur local OpenAI-compatible) ---
V100_BASE_URL=http://127.0.0.1:8000/v1
V100_MODEL=Qwen/Qwen2.5-14B-Instruct-AWQ
V100_API_KEY=not-needed
